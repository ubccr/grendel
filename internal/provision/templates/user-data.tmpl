#cloud-config

users:
  - name: grendeladmin
    primary_group: grendeladmin
    groups: users, admin
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
{{- with $.extra_vars.ssh_keys }}
    ssh_authorized_keys:
   {{- range $i, $key := . }}
      - {{ $key }}
   {{- end }}
{{ end }}

phone_home:
  url: {{ $.endpoints.CompleteURL }}
  post: [ instance_id ]

final_message: "The system is finally up, after $UPTIME seconds"
