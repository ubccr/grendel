variant: flatcar
version: 1.0.0
{{- if or $.extra_vars.root_password $.extra_vars.ssh_keys }}
passwd:
  users:
{{- with $.extra_vars.root_password }}
    - name: root
      password_hash: {{ . }}
{{- end }}
{{- with $.extra_vars.ssh_keys }}
    - name: core
      ssh_authorized_keys:
      {{- range $i, $key := . }}
        - "{{ $key }}"
      {{- end }}
{{- end }}
{{- end }}
storage:
  files:
    - path: /etc/systemd/network/10-static.network
      mode: 0644
      contents:
        inline: |
          [Match]
          MACAddress={{ $.nic.MAC }}

          [Link]
          MTUBytes={{ or $.nic.MTU 1500 }}

          [Network]
          DNS={{ index $.nic.DNS 0 }}
          Domains={{ Join $.nic.DomainSearch " " }}
          Address={{ $.nic.IP }}
          Gateway={{ $.nic.Gateway }}
{{- if $.beacon.enabled }}
{{- if $.beacon.served }}
    - path: {{ $.beacon.path }}
      mode: 0755
      contents:
        source: {{ $.beacon.url }}
{{- end }}
    - path: /etc/grendel/beacon.env
      mode: 0600
      contents:
        inline: |
          GRENDEL_STATUS_URL={{ $.endpoints.StatusURL }}
systemd:
  units:
    - name: grendel-beacon.service
      enabled: true
      contents: |
        [Unit]
        Description=Report provision status to grendel
        Wants=network-online.target
        After=network-online.target

        [Service]
        Type=simple
        EnvironmentFile=/etc/grendel/beacon.env
        ExecStart={{ $.beacon.path }} watch{{ if $.beacon.complete }} --complete{{ end }}

        [Install]
        WantedBy=multi-user.target
{{- end }}
