variant: flatcar
version: 1.0.0
passwd:
{{- with $.extra_vars.root_password }}
    - name: root
      password_hash: {{ . }}
{{ end }}
{{- with $.extra_vars.ssh_keys }}
    - name: core
      ssh_authorized_keys:
      {{- range $i, $key := . }}
        - "{{ $key }}"
      {{- end }}
{{ end }}

  files:
    - path: /etc/systemd/network/10-static.network
      mode: 0644
      contents:
        inline: |
          [Match]
          MACAddress={{ $.nic.MAC }}

          [Link]
          MTUBytes={{ or $.nic.MTU 1500 }}

          [Network]
          DNS={{ index $.nic.DNS 0 }}
          Domains={{ Join $.nic.DomainSearch " " }}
          Address={{ $.nic.IP }}
          Gateway={{ $.nic.Gateway }}
