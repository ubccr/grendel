[grendel]
map: grendel node show --tags $GROUP | jq '.[] | select(.name | contains("cpn")) | .name' -r
all: grendel node show | jq '.[] | select(.name | contains("cpn")) | .name' -r | grep cpn
list: grendel node show | jq '.[] | select(.name | contains("cpn")) | .tags.[] | select(. | contains(":") | not)' -r
reverse: grendel node show $NODE | jq '.[].tags.[] | select(. | contains(":") | not)' -r
