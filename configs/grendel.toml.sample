# Grendel config file

# Settings in this file must be configured here and not in the DB. Other settings may be added to prevent runtime modification
# See `grendel config -h` for more information.


# Path to persistent DB file
dbpath = '/var/lib/grendel/db/grendel.sqlite3'

# List of services to run, see `grendeld serve -h` for more info
#services = []


[api]
# UNIX socket path
# Allows for local CLI access without API tokens, there is no RBAC and access control is UNIX permission based
socket_path = '/var/lib/grendel/grendel-api.socket'


# Always use TLS when listening on a TCP socket:

# Path to TLS certificate
#cert = ''

# Path to TLS private key
#key = ''

# Development only: disables RBAC
#dev = false


# Redfish BMC credentials
# Tried in order so you can include factory defaults or old credentials
#[[bmc.credentials]]
#username = ''
#password = ''
#[[bmc.credentials]]
#username = ''
#password = ''


[tftp]
# Path to iPXE firmware. See `grendeld firmware -h`
#firmware_dir = ''


# CLI Client config
[client]
# UNIX socket path or API URL
api_endpoint = '/var/lib/grendel/grendel-api.socket'

# API auth token for connecting over TCP
#api_key = ''

# Allow self-signed certificates
#insecure = false

# Path to a CA certificate for API TLS verification
#cacert = ''


[provision]
# Path to TLS certificate
#cert = ''

# Path to TLS private key
#key = ''

# Path to repo directory
# Served to nodes at /repo
repo_dir = '/var/lib/grendel/repo'

# Path to provision templates
# Hot reloaded on file update, templates with matching names will override embedded templates
templates_dir = '/var/lib/grendel/templates'

# NetBox API token for fetching rendered NetBox templates for a node
#netbox_token = ''

# Custom variables used in templates as {{ $.extra_vars.name }}
# Keep extra secrets in here, and non sensitive information in the DB
[provision.extra_vars]

[provision.beacon]
# Path to beacon binaries
# Optional node service that reports boot status back to Grendel
dir = '/usr/lib/grendel/beacon'


[switch]
# Switch credentials
# Used for gNMI LLDP and MAC address table queries
#username = ''
#password = ''

[switch.snmp]
# SNMPv2c community string
#community = 'public'

# SNMPv3 auth password
#auth_pass = ''

# SNMPv3 privacy password
#priv_pass = ''
