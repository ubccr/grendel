#------------------------------------------------------------------------------
# Grendel Config
#------------------------------------------------------------------------------

#------------------------------------------------------------------------------
# General
#------------------------------------------------------------------------------

#
# Database type: sqlite (default)
dbtype = "sqlite"
#

#
# Path database file. Defaults to ":memory:" which uses in-memory store. Change
# this to a filepath for persisent storage.
#
dbpath = "grendel.db"

#
# By default, all loggers are on. You can turn off logging for specific
# services here.
#
loggers = { cli = "on", tftp = "on", dhcp = "on", dns = "on", provision = "on", api = "on", pxe = "on" }

#
# Admin ssh public keys. These are used in provision templates and elsewhere for
# administrative ssh access
#
admin_ssh_pubkeys = []

#
# Services to run. Valid entries are api, dhcp, dns, provision, pxe and tftp.
# Leave this empty or unset to run all of them. Naming services on the command
# line, as in `grendel serve dhcp dns`, overrides this.
#
services = ["api", "provision"]

#
# How long to wait for a service to stop before giving up on it during shutdown
#
shutdown_timeout = "10s"

#------------------------------------------------------------------------------
# Database
#------------------------------------------------------------------------------
[database]

#
# Maximum number of concurrent read connections. Reads do not block each other,
# so there is little to gain above the core count, and an unbounded pool lets a
# burst of slow queries exhaust file descriptors and OS threads.
#
max_read_conns = 8

#------------------------------------------------------------------------------
# HTTP Provision Server
#------------------------------------------------------------------------------
[provision]
# TODO: document
scheme = "http"


# Listen address for provision server
listen = "0.0.0.0:8081"

# Set static hostname for grendel (should match SSL certificate and resolve in DNS)
#hostname = "my.host.name"

# Path to ssl cert (.crt file)
#cert = "/path/to/cert/file/hostname.crt"

# Path to ssl key (.key file)
#key = "/path/to/cert/file/hostname.key"

# TTL in seconds for provision tokens. Defaults to 1 hour
token_ttl = 3600

# Can generate secret with `openssl rand -hex 16`
secret = "bb6f10293c615bbd7670f93b0429f3c8"

# Hashed root password used in kickstart template
root_password = ""

# Default OS image name
default_image = ""

# Path to repo directory
repo_dis = "/var/lib/grendel/repo"
templates_dir = "/var/lib/grendel/"

# Enable prometheus service discover endpoint
enable_prometheus_sd = true

# Prometheus service discovery refresh interval in seconds
prometheus_sd_refresh_interval = 3600

# Enable netbox render config support
# netbox_token=""
# netbox_url=""
#

status_check_source = false


# Here is where you can pass extra variables into provision templates
# They can be accessed like so: {{ $.extra_vars.root_password }}
[provision.extra_vars]
# root_password = ""

#------------------------------------------------------------------------------
# DHCP Server
#------------------------------------------------------------------------------
[dhcp]
listen = "0.0.0.0:67"

# Default lease time
lease_time = "24h"

# List of default DNS servers
dns_servers = []

# List of default DNS search domains
domain_search = []

# Default MTU
mtu = 1500

# Only run DHCP Proxy server
proxy_only = false

# Dynamic router configuration. Grendel will generate the router option 3 for
# DHCP responses based on the hosts IP address, netmask, and router_octet4. For
# example, if all subnets in your data center have routers 10.x.x.254 you can
# set router_octet4 = 254. If a host ip address is 10.104.13.10, Grendel will
# set the router option in the dhcp response to 10.104.13.254. This setting is
# off by default.
router_octet4 = 0

# Hard code a static default gateway. (Not set by default)
#gateway = ""

# Configure settings for specific subnets. If a hosts IP address is contained
# inside the subnet, the static dhcp response will contain the gateway IP
# address, dns, and MTU settings for the given subnet. The gateway defines both
# the gateway IP and the netmask prefix for the subnet. For example, gateway =
# "10.17.41.254/23" will check if host IP falls in the network prefix
# 10.17.40.0/23 and if so set the dhcp gateway/router to 10.17.41.254.
#
#subnets = [
#    {gateway = "10.17.41.254/23",  dns = "10.17.40.248", mtu="1500"}
# ]

[[dhcp.subnets]]
gateway = "10.17.31.254/20"
dns = "172.18.35.3"
domainsearch = "dev.ccr.buffalo.edu,mgmt.ccr.buffalo.edu,ccr.buffalo.edu"
[[dhcp.subnets]]
gateway = "172.18.255.254/16"
dns = "172.18.35.3"
domainsearch = "mgmt.ccr.buffalo.edu"
[[dhcp.subnets]]
gateway = "10.17.45.126/25"
dns = "10.18.34.3"
domainsearch = "core.ccr.buffalo.edu"
[[dhcp.subnets]]
gateway = "10.18.67.254/24"
dns = "10.18.34.3"
domainsearch = "dev.ccr.buffalo.edu,core.ccr.buffalo.edu,ccr.buffalo.edu"
# ]

# [[dhcp.subnets]]
# gateway = "10.0.0.1/24"
# [[dhcp.subnets]]
# gateway = "10.0.1.1/24"


#------------------------------------------------------------------------------
# DNS Server
#------------------------------------------------------------------------------
[dns]
listen = "0.0.0.0:4053"

# Default TTL for dns responses
ttl = 86400

# Address that Grendel should forward unknown DNS queries to
# By default Grendel is only a recursive resolver
#forward = "1.1.1.1:53"

#------------------------------------------------------------------------------
# TFTP Server
#------------------------------------------------------------------------------
[tftp]
listen = "0.0.0.0:69"

#------------------------------------------------------------------------------
# PXE Server
#------------------------------------------------------------------------------
[pxe]
listen = "0.0.0.0:4011"

#------------------------------------------------------------------------------
# API Server
#------------------------------------------------------------------------------
[api]
# API server listen config:
# Set either socket_path or listen

# socket_path will bind the api server to a unix socket
# Authentication and the frontend will be disabled
socket_path = "grendel-api.socket"

# listen will bind the api server to a tcp socket
# If possible, always bind the address to an internal mgmt network
listen = "127.0.0.1:8080"

# Required for auth to work across restarts
# Can be generated with `openssl rand -hex 16`
secret = "528ff688ceee37ebb6f7ec1141648c1f"

# HTTPS certs, setting both key and cert will enable https
# You should always use https if listening over tcp
key = "/etc/grendel/api/hostname.key"
cert = "/etc/grendel/api/hostname.crt"

# Enables or disables Web UI
# Only served on tcp listener
web_ui = true

# Development settings:
# Swagger API browser, requires CORS = true to test api routes
swagger_ui = true
# When enabled, allow any request method from any origin
cors = true
dev = true

#------------------------------------------------------------------------------
# Client Config
#------------------------------------------------------------------------------
[client]
# Grendel API endpoint
# Can be a URL or unix socket path
# Example if binding the API over tcp: api_endpoint = "http://localhost:8080"
api_endpoint = "./grendel-api.socket"
# api_endpoint = "https://localhost:8080"

# api_key = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYWRtaW4iLCJ1c2VybmFtZSI6ImFkbWluIn0._JVBEQW2ysw9S9uNUKYIu7DaMJDlwxEJnRZuNPSu22Q"

# Verify ssl certs? false (yes) true (no)
insecure = true

#------------------------------------------------------------------------------
# Network switches
#------------------------------------------------------------------------------
# Switches are nodes tagged "switch" plus one of arista, sonic or dellos10, and Grendel reaches them on their first interface. Arista and SONiC are read over gNMI, Dell OS10 over SNMP.
[switch]
# gNMI login. When both are empty, the older bmc.switch_admin_username and bmc.switch_admin_password are used.
username = "admin"
password = "test"
timeout = "30s"

[switch.gnmi]
port = 6030
# Plaintext gRPC with no TLS, which is the EOS default for "management api gnmi".
plaintext = false
# Accept the switch's self-signed certificate. Ignored when ca_cert is set.
skip_verify = true
ca_cert = ""
# Network instance holding the MAC table. Some SONiC builds need "*" or a VLAN name here.
network_instance = "default"

# Any gNMI setting above can be overridden per NOS.
[switch.gnmi.arista]
plaintext = true

[switch.gnmi.sonic]
port = 8080

[switch.snmp]
# "2c" or "3"
version = "2c"
community = "public"
port = 161
timeout = "5s"
retries = 2
# SNMPv3 only. auth_proto: MD5, SHA, SHA224, SHA256, SHA384, SHA512. priv_proto: DES, AES, AES192, AES256, AES192C, AES256C.
#user = ""
#auth_proto = "SHA"
#auth_pass = ""
#priv_proto = "AES"
#priv_pass = ""

#------------------------------------------------------------------------------
# Global BMC Config
#------------------------------------------------------------------------------
[bmc]
user = "ccrbmc"
password = ""
switch_admin_username = "admin"
switch_admin_password = "fakeswitch"
scheme = "http"

# Allow unsigned https certs for redfish queries
insecure = true

# bmc runner settings:
# sets number of active queries allowed at one time
fanout = 20
# number of seconds after a query completes to wait before sending another
delay = 1

# IP sent to the BMC for import system config, should be an IP of the provision
# server which is reachable by the BMCs
#config_share_ip = "0.0.0.0"
# Import System Config setting: Set to "Enabled" if using a self signed
# certificate on the provision server
#config_ignore_certificate_warning = "Disabled"

config_share_ip = "grendel-prod.mgmt.ccr.buffalo.edu"
config_ignore_certificate_warning = "Enabled"

[bmc.gofish]
# Advanced gofish connection options. See https://github.com/ubccr/grendel/blob/main/internal/bmc/client.go#L40 for implementation details
max_concurrent_requests = 1
reuse_connections = false

client_timeout = "60s"
dial_timeout = "5s"
dial_keep_alive_timeout = "30s"
tls_handshake_timeout = "10s"
idle_conn_timeout = "90s"
basic_auth = true

#------------------------------------------------------------------------------
# Automatic Host Discovery Config
#------------------------------------------------------------------------------
[discovery]
user = ""
password = ""
domain = ""
